# Copy to .env for local development. .env is gitignored — never commit real credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/riamxo?retryWrites=true&w=majority
MONGODB_DB=riamxo
# Stable session-signing secret. Required in production so every serverless
# instance verifies the same tokens; a random per-instance fallback logs users out.
RIAMXO_SECRET=<64-char-hex>
