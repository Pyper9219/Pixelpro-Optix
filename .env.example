# Copy to .env for local development. .env is gitignored — never commit real credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/riamxo?retryWrites=true&w=majority
MONGODB_DB=riamxo
# Optional first-boot seed for the session-signing secret. The real secret is
# stored in the app_meta collection so all serverless instances share it; leave
# this unset and a random one is generated and persisted on first connection.
RIAMXO_SECRET=<64-char-hex>
